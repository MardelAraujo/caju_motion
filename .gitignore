node_modules/
dist/
out/
*.log
*.tgz
.DS_Store

# chaves de API (caju tts)
.env
.env.*
!.env.example

# cache e histórico locais de cada projeto (.frame/ = nome antigo)
# exceto a base do último caju build, que permite detectar edições do Studio em clones novos
**/.caju/*
!**/.caju/last-build.json
.frame/

# cache dos geradores (narração etc.)
.cache/

# fontes locais do Studio (não redistribuíveis), ver packages/studio/public/fonts/local
packages/studio/public/fonts/local/

# arquivos temporários do teste das skills
packages/skills/.check/

# vídeos exportados (caju render / botão Exportar)
renders/

# site de docs (VitePress): build + llms gerados no CI
docs-site/.vitepress/dist/
docs-site/.vitepress/cache/
docs-site/public/llms.txt
docs-site/public/llms-full.txt

# projetos privados da AutoMind (cópias de ../caju-automind-private): nunca no repositório público
projects/autochecker-papel/
projects/autochecker-papel-v2/
projects/jornada-documento/
