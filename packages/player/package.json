  "description": "Caju Motion player: embed a project.json video in any React app, with controls, audio and an imperative API.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MardelAraujo/caju_motion.git",
