{
  "name": "@caju-motion/server",
  "version": "0.1.0",
  "description": "Caju Motion local server: project store (atomic saves + history), assets API and the production Studio server.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MardelAraujo/caju_motion.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/MardelAraujo/caju_motion#readme",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts"
  },
  "dependencies": {
    "@caju-motion/schema": "0.1.0",
    "@hono/node-server": "^2.1.3",
    "esbuild": "^0.28.2",
    "hono": "^4.13.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
